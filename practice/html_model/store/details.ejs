<body>
   <%- include ('../partial/header') %>
    <main class="container mx-auto bg-white p-4 shadow">
       <h2 class="text-2xl font-bold text-gray-800">this is your home details</h2>

 
   <ul>
    <li class="border-b py-2">

        <h3 class="text-xl font-semibold text-gray-700">
            <%= home.name %>
        </h3>

        <p class="text-gray-600">
            <%= home.description %>
        </p>

        <p class="text-gray-500">
            Price: $<%= home.price %> per night
        </p>

    </li>
<%- include('../partial/fav') %>
 </ul>
<div class="inline-block">
    <img 
        src="<%= home.photoUrl %>" 
        alt="<%= home.name %>"
        class="h-8 w-8 rounded-full object-cover border"
    >
</div>

             
    </main>
</body>
</html>