<%- include ('../partial/doc') %>
</head>
<body>
   <%- include ('../partial/header') %>
    <main class="container mx-auto bg-white p-4 shadow">
       <h2 class="text-2xl font-bold text-gray-800">Your Favorite Homes</h2>
    <ul>
    <% favhome.forEach(home => {  %>
        <li class="border-b py-2">
             
            <h3 class="text-xl font-semibold text-gray-700"><%= home.name %></h3>
            <p class="text-gray-600"><%= home.description %></p>
            <p class="text-gray-500">Price: $<%= home.price %> per night</p>
        </li>

        <form action="/store/favlist/deletehome/<%= home.id %>" method="POST">
                <button class="bg-red-300 p-2" type="submit">Remove from favourite</button>
              </form>
    <% }) %>
     
    </ul>
    </main>
</body>